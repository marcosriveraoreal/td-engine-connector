# --- TDengine (origen) ---
TD_URL=http://<host-tdengine>:6041/rest/sql
TD_USER=changeme
TD_PASSWORD=changeme
TD_DATABASE=eic_data
TD_TABLE=eic_tags_float
# Filtro de subtablas (tbname LIKE). Solo se sincronizan las subtablas cuyo nombre
# contenga este patrón. El valor por defecto trae los tags orientados a PowerBI.
TD_TBNAME_PATTERN=%PowerBi%
# Fichero con la lista de tags a sincronizar, uno por línea (ver config/tags.txt).
TD_TAGS_FILE=/app/config/tags.txt
# Fichero con la lista de tags de horometros (ver config/horometros_tags.txt).
# Usa LAST(val) por hora en lugar de TWA. Dejar vacío para deshabilitar esta consulta.
TD_HOROMETROS_TAGS_FILE=/app/config/horometros_tags.txt
# Ventana de la agregación, relativa a TODAY() (medianoche de hoy en TDengine).
TD_WINDOW_LOOKBACK_HOURS=15
TD_WINDOW_LOOKAHEAD_HOURS=9
TD_AGG_INTERVAL=1h
TD_REQUEST_TIMEOUT_SECONDS=120

# --- SQL Server (destino) ---
MSSQL_HOST=sqlserver.internal
MSSQL_PORT=1433
MSSQL_DATABASE=EIC
MSSQL_USER=connector_user
MSSQL_PASSWORD=changeme
MSSQL_TARGET_TABLE=dbo.EicTagsHourlyAvg
# Tabla destino para los horometros. Solo se usa si TD_HOROMETROS_TAGS_FILE está definido.
MSSQL_HOROMETROS_TABLE=dbo.EicHorometrosHourly
MSSQL_CONNECT_TIMEOUT_SECONDS=15
# yes|no. Debe coincidir con lo que ya use vuestro backend Spring/JDBC contra este servidor.
MSSQL_ENCRYPT=no
# yes|no. Solo relevante si MSSQL_ENCRYPT=yes.
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# --- Planificación ---
# Valor inicial únicamente: a partir del primer arranque, la planificación se gestiona desde
# el panel web (pestaña "Configuración" — intervalo fijo, horas concretas o cron avanzado) y
# se persiste en SCHEDULE_STATE_FILE, con prioridad sobre esta variable en los siguientes
# arranques. Expresión cron estándar (min hora dia mes dia_semana), evaluada en HORA DE MADRID
# (Europe/Madrid), no en UTC.
# Ejemplos:
#   "*/5 * * * *"  -> cada 5 minutos
#   "0 * * * *"    -> cada hora en punto
#   "0 6 * * *"    -> una vez al día a las 06:00, hora de Madrid
SCHEDULE_CRON=*/5 * * * *
SCHEDULE_STATE_FILE=/app/state/schedule.json
# Si es true, ejecuta un único ciclo de sincronización y termina (útil para pruebas o cron
# externo). En este modo no se levanta el panel web ni se puede lanzar una ejecución manual.
RUN_ONCE=false

# --- Observabilidad ---
LOG_LEVEL=INFO
HEARTBEAT_FILE=/app/state/heartbeat
# Ruta del fichero groups.json (el healthcheck lo lee para calcular el umbral adaptativo).
GROUPS_STATE_FILE=/app/state/groups.json
# Margen extra (segundos) que se añade al período del schedule antes de declarar el contenedor
# "unhealthy". Si el cron es cada hora, el umbral será 3600 + HEARTBEAT_GRACE_SECONDS.
HEARTBEAT_GRACE_SECONDS=300

# --- Panel web de monitorización ---
# Dashboard con sesión: estado, historial de ciclos (con motivo de fallo), frescura de datos
# por tag, logs en vivo, ejecución manual y configuración de la planificación.
WEB_UI_ENABLED=true
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=3892
# Cuenta única del panel. Si dejas ambas vacías, se genera un usuario "admin" con contraseña
# aleatoria al arrancar (se imprime una vez en el log del contenedor y se pierde al reiniciar):
# para una contraseña estable, define las dos.
WEB_UI_USER=
WEB_UI_PASSWORD=
# Clave para firmar la sesión del panel. Si se deja vacía se genera una al arrancar (las
# sesiones no sobreviven a un reinicio del contenedor); defínela para que no se cierre la
# sesión de todo el mundo cada vez que se reconstruye la imagen.
WEB_UI_SECRET_KEY=
# Cuántos ciclos y líneas de log se guardan en memoria para el panel (se pierden al reiniciar).
WEB_UI_MAX_RUNS_HISTORY=200
WEB_UI_MAX_LOG_LINES=1000
# Cada cuántos segundos hace polling el navegador a la API del panel.
WEB_UI_REFRESH_SECONDS=10

# --- Identidad visual del panel ---
COMPANY_NAME=Atalaya Mining
PRODUCT_NAME=connector-td-engine
# Color de acento (hex). Se usa en la cabecera, botones principales y enlaces.
BRAND_ACCENT_COLOR=#c8763a
# Logo propio, opcional. Puede ser una URL http(s), una data URI, o el nombre de un fichero
# dentro de ./assets (se sirve desde el propio conector en /assets/<fichero>; basta con poner
# "logo.png", no hace falta escribir "/assets/logo.png"). Si se deja vacío, se muestra un
# distintivo con las iniciales de COMPANY_NAME.
BRAND_LOGO_URL=
# Carpeta servida en /assets/ (contiene el logo). Cambiarla solo si se monta desde otra ruta.
ASSETS_DIR=/app/assets

TZ=Europe/Madrid
